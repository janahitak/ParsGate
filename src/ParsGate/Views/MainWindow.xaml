<Window x:Class="ParsGate.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ParsGate v0.3"
        Height="650"
        Width="1000"
        MinHeight="600"
        MinWidth="900"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="{StaticResource FontVazirmatn}"
        FontSize="18"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource GlobalWindowStyle}"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        Icon="pack://application:,,,/Assets/app.ico">
    
    <Window.Resources>
        <Style x:Key="MainButtonStyle" TargetType="Button" BasedOn="{StaticResource GlobalButtonStyle}">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="24,12" />
        </Style>
        
        <Style x:Key="HugeConnectButtonStyle" TargetType="Button" BasedOn="{StaticResource GlobalButtonStyle}">
            <Setter Property="Width" Value="320" />
            <Setter Property="Height" Value="140" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="4" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Row: Three Big Accessible Buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Button x:Name="BtnAddFromClipboard"
                    Content="افزودن کانفیگ از کلیپ‌بورد"
                    Style="{StaticResource MainButtonStyle}"
                    Width="300"
                    AutomationProperties.Name="افزودن کانفیگ از کلیپ‌بورد"
                    Click="BtnAddFromClipboard_Click" />
            
            <Button x:Name="BtnOpenSettings"
                    Content="تنظیمات و اسپلیت تونلینگ"
                    Style="{StaticResource MainButtonStyle}"
                    Width="300"
                    Margin="16,0,16,0"
                    AutomationProperties.Name="تنظیمات و اسپلیت تونلینگ"
                    Click="BtnOpenSettings_Click" />
            
            <Button x:Name="BtnManageSubscriptions"
                    Content="مدیریت لینک‌های اشتراک"
                    Style="{StaticResource MainButtonStyle}"
                    Width="300"
                    AutomationProperties.Name="مدیریت لینک‌های اشتراک"
                    Click="BtnManageSubscriptions_Click" />
        </StackPanel>

        <!-- Center Section: Huge Connect/Disconnect Button -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button x:Name="BtnConnectDisconnect"
                    Content="اتصال"
                    Style="{StaticResource HugeConnectButtonStyle}"
                    Background="#004400"
                    BorderBrush="#00FF00"
                    Foreground="#FFFFFF"
                    Tag="Disconnected"
                    Click="BtnConnectDisconnect_Click"
                    Focusable="True"
                    IsDefault="True"
                    AutomationProperties.Name="دکمه اتصال و قطع اتصال" />
        </Grid>

        <!-- Bottom Control Row: Config Selection & Ping Actions -->
        <Border Grid.Row="2" Background="#0A0A0A" BorderBrush="#FFFFFF" BorderThickness="2" CornerRadius="6" Padding="12" Margin="0,16,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="ConfigComboBox"
                          Grid.Column="0"
                          Width="400"
                          MinHeight="48"
                          FontSize="18"
                          FontFamily="{StaticResource FontVazirmatn}"
                          Background="#000000"
                          Foreground="#FFFFFF"
                          BorderBrush="#FFFFFF"
                          BorderThickness="3"
                          Padding="8,4"
                          AutomationProperties.Name="لیست کانفیگ‌ها"
                          SelectionChanged="ConfigComboBox_SelectionChanged"
                          DisplayMemberPath="DisplayText" />

                <Button x:Name="BtnTestPing"
                        Grid.Column="1"
                        Content="تست پینگ واقعی"
                        Style="{StaticResource GlobalButtonStyle}"
                        Width="160"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="تست پینگ واقعی برای همه کانفیگ‌ها"
                        Click="BtnTestPing_Click" />

                <Button x:Name="BtnSortByPing"
                        Grid.Column="2"
                        Content="مرتب‌سازی بهترین پینگ"
                        Style="{StaticResource GlobalButtonStyle}"
                        Width="180"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="مرتب‌سازی کانفیگ‌ها بر اساس بهترین پینگ"
                        Click="BtnSortByPing_Click" />

                <Button x:Name="BtnCleanupConfigs"
                        Grid.Column="3"
                        Content="حذف کانفیگ‌های خراب و تکراری"
                        Style="{StaticResource GlobalButtonStyle}"
                        Width="200"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="حذف کانفیگ‌های تکراری و پینگ منفی"
                        Click="BtnCleanupConfigs_Click" />
            </Grid>
        </Border>

        <!-- Footer Live Status Bar -->
        <Border Grid.Row="3" Background="#000000" BorderBrush="#333333" BorderThickness="0,2,0,0" Padding="8,4" Margin="0,8,0,0">
            <TextBlock x:Name="LiveStatusText"
                       Text="ParsGate آماده است. برای اتصال کانفیگ اضافه کنید یا از کلیپ‌بورد وارد کنید."
                       FontSize="16"
                       FontFamily="{StaticResource FontVazirmatn}"
                       Foreground="#D4AF37"
                       AutomationProperties.LiveSetting="Assertive"
                       AutomationProperties.Name="نوار وضعیت زنده"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>