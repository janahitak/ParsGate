<Window x:Class="ParsGate.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ParsGate v0.1"
        Height="600"
        Width="1000"
        MinHeight="500"
        MinWidth="800"
        Style="{StaticResource GlobalWindowStyle}"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="ParsGate"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#D4AF37"
                       FontFamily="{StaticResource FontVazirmatn}" />
            <TextBlock Text=" v0.1"
                       FontSize="20"
                       Foreground="#FFFFFF"
                       FontFamily="{StaticResource FontVazirmatn}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
        </StackPanel>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Style="{StaticResource GlobalTabControlStyle}">
            <TabItem Header="Configurations" Style="{StaticResource GlobalTabItemStyle}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="SubscriptionUrlBox"
                                 Width="400"
                                 PlaceholderText="Subscription URL"
                                 Style="{StaticResource GlobalTextBoxStyle}" />
                        <Button Content="Add Subscription"
                                Margin="8,0,0,0"
                                Style="{StaticResource GlobalButtonStyle}"
                                Click="AddSubscription_Click" />
                        <Button Content="Update All"
                                Margin="8,0,0,0"
                                Style="{StaticResource GlobalButtonStyle}"
                                Click="UpdateSubscriptions_Click" />
                    </StackPanel>

                    <ListView x:Name="ConfigListView"
                              Grid.Row="1"
                              Background="#000000"
                              Foreground="#FFFFFF"
                              BorderBrush="#FFFFFF"
                              BorderThickness="2"
                              FontFamily="{StaticResource FontVazirmatn}"
                              FontSize="16"
                              Margin="0,0,0,8">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="250" />
                                <GridViewColumn Header="Protocol" DisplayMemberBinding="{Binding Protocol}" Width="100" />
                                <GridViewColumn Header="Server" DisplayMemberBinding="{Binding ServerAddress}" Width="200" />
                                <GridViewColumn Header="Port" DisplayMemberBinding="{Binding Port}" Width="80" />
                                <GridViewColumn Header="Ping" DisplayMemberBinding="{Binding LastPingMs}" Width="80" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Connect Selected"
                                Style="{StaticResource GlobalButtonStyle}"
                                Click="Connect_Click"
                                Tag="Active" />
                        <Button Content="Test Ping"
                                Margin="8,0,0,0"
                                Style="{StaticResource GlobalButtonStyle}"
                                Click="TestPing_Click" />
                        <Button Content="Remove"
                                Margin="8,0,0,0"
                                Style="{StaticResource GlobalButtonStyle}"
                                Click="RemoveConfig_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Settings" Style="{StaticResource GlobalTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <GroupBox Header="Core Settings" Style="{StaticResource GlobalGroupBoxStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox x:Name="IranDirectCheck"
                                          Content="Iran Direct (Route .ir & geoip-ir directly)"
                                          Style="{StaticResource GlobalCheckBoxStyle}"
                                          IsChecked="True"
                                          Margin="0,8" />
                                <CheckBox x:Name="SplitTunnelCheck"
                                          Content="Enable Split Tunneling"
                                          Style="{StaticResource GlobalCheckBoxStyle}"
                                          Margin="0,8" />
                                <StackPanel Orientation="Horizontal" Margin="24,0,0,8">
                                    <TextBlock Text="Mode:" VerticalAlignment="Center" Foreground="#FFFFFF" FontFamily="{StaticResource FontVazirmatn}" FontSize="16" />
                                    <ComboBox x:Name="SplitTunnelModeBox"
                                              Width="200"
                                              Margin="8,0,0,0"
                                              Style="{StaticResource GlobalComboBoxStyle}"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Exclude Selected Apps" Tag="ExcludeApps" />
                                        <ComboBoxItem Content="Only Selected Apps" Tag="OnlySelectedApps" />
                                    </ComboBox>
                                </StackPanel>
                                <TextBox x:Name="SplitTunnelProcessesBox"
                                         PlaceholderText="Process names (comma-separated, e.g., chrome.exe,firefox.exe)"
                                         Style="{StaticResource GlobalTextBoxStyle}"
                                         Margin="24,0,0,8" />
                                <TextBox x:Name="SplitTunnelDomainsBox"
                                         PlaceholderText="Custom domains/IPs (comma-separated)"
                                         Style="{StaticResource GlobalTextBoxStyle}"
                                         Margin="24,0,0,8" />

                                <CheckBox x:Name="KillSwitchCheck"
                                          Content="Kill Switch (Block all traffic if tunnel fails)"
                                          Style="{StaticResource GlobalCheckBoxStyle}"
                                          Margin="0,8" />

                                <CheckBox x:Name="ForceFragmentCheck"
                                          Content="Force Fragment (TLS Hello fragmentation)"
                                          Style="{StaticResource GlobalCheckBoxStyle}"
                                          Margin="0,8" />
                                <StackPanel Orientation="Horizontal" Margin="24,0,0,8">
                                    <TextBlock Text="Length:" VerticalAlignment="Center" Foreground="#FFFFFF" FontFamily="{StaticResource FontVazirmatn}" FontSize="16" />
                                    <TextBox x:Name="FragmentLengthBox"
                                             Text="10-20"
                                             Width="100"
                                             Style="{StaticResource GlobalTextBoxStyle}"
                                             Margin="8,0,0,0" />
                                    <TextBlock Text="Interval:" VerticalAlignment="Center" Foreground="#FFFFFF" FontFamily="{StaticResource FontVazirmatn}" FontSize="16" Margin="16,0,0,0" />
                                    <TextBox x:Name="FragmentIntervalBox"
                                             Text="10-20"
                                             Width="100"
                                             Style="{StaticResource GlobalTextBoxStyle}"
                                             Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Auto Behavior" Style="{StaticResource GlobalGroupBoxStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox x:Name="AutoConnectCheck"
                                          Content="Auto Connect on Start"
                                          Style="{StaticResource GlobalCheckBoxStyle}"
                                          Margin="0,8" />
                                <CheckBox x:Name="AutoUpdateCheck"
                                          Content="Auto Update Subscriptions on Start"
                                          Style="{StaticResource GlobalCheckBoxStyle}"
                                          IsChecked="True"
                                          Margin="0,8" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Custom DNS" Style="{StaticResource GlobalGroupBoxStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <TextBlock Text="Remote DNS (DoH):" Width="180" VerticalAlignment="Center" Foreground="#FFFFFF" FontFamily="{StaticResource FontVazirmatn}" FontSize="16" />
                                    <TextBox x:Name="RemoteDnsBox"
                                             Text="https://1.1.1.1/dns-query"
                                             Width="400"
                                             Style="{StaticResource GlobalTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <TextBlock Text="Direct DNS:" Width="180" VerticalAlignment="Center" Foreground="#FFFFFF" FontFamily="{StaticResource FontVazirmatn}" FontSize="16" />
                                    <TextBox x:Name="DirectDnsBox"
                                             Text="1.1.1.1"
                                             Width="400"
                                             Style="{StaticResource GlobalTextBoxStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Backup & Restore" Style="{StaticResource GlobalGroupBoxStyle}" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Export Settings"
                                        Style="{StaticResource GlobalButtonStyle}"
                                        Click="ExportSettings_Click" />
                                <Button Content="Import Settings"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource GlobalButtonStyle}"
                                        Click="ImportSettings_Click" />
                            </StackPanel>
                        </GroupBox>

                        <Button x:Name="SaveSettingsBtn"
                                Content="Save Settings"
                                HorizontalAlignment="Right"
                                Style="{StaticResource GlobalButtonStyle}"
                                Tag="Active"
                                Click="SaveSettings_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Logs" Style="{StaticResource GlobalTabItemStyle}">
                <Grid Margin="8">
                    <TextBox x:Name="LogBox"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="#000000"
                             Foreground="#00FF00"
                             BorderBrush="#FFFFFF"
                             BorderThickness="2"
                             FontFamily="Consolas, Tahoma"
                             FontSize="14"
                             Padding="8" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       VerticalAlignment="Center"
                       Foreground="#FFFFFF"
                       FontFamily="{StaticResource FontVazirmatn}"
                       FontSize="16" />
            <TextBlock x:Name="ConnectionStatus"
                       Text="Disconnected"
                       VerticalAlignment="Center"
                       Foreground="#FF0000"
                       FontFamily="{StaticResource FontVazirmatn}"
                       FontSize="16"
                       Margin="16,0,0,0" />
        </StackPanel>
    </Grid>
</Window>