<Window x:Class="ParsGate.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="تنظیمات ParsGate"
        Height="750"
        Width="800"
        MinHeight="700"
        MinWidth="750"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="{StaticResource FontVazirmatn}"
        FontSize="18"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource GlobalWindowStyle}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <!-- Section 1: Core Toggles -->
            <GroupBox Header="تنظیمات اصلی" Style="{StaticResource GlobalGroupBoxStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="IranDirectCheck"
                              Content="مسیریابی مستقیم سایت‌ها و آی‌پی‌های ایران (Iran Direct)"
                              Style="{StaticResource GlobalCheckBoxStyle}"
                              Margin="0,8"
                              AutomationProperties.Name="مسیریابی مستقیم ایران" />
                    <Button Content="بروزرسانی قوانین ایران"
                            Style="{StaticResource GlobalButtonStyle}"
                            Width="220"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,16"
                            Click="BtnUpdateIranRules_Click"
                            AutomationProperties.Name="دانلود و بروزرسانی فایل‌های geoip-ir و geosite-ir" />

                    <CheckBox x:Name="KillSwitchCheck"
                              Content="کیل سوئیچ (قطع کامل اینترنت در صورت قطع فیلترشکن)"
                              Style="{StaticResource GlobalCheckBoxStyle}"
                              Margin="0,8"
                              AutomationProperties.Name="کیل سوئیچ" />

                    <CheckBox x:Name="ForceFragmentCheck"
                              Content="اعمال فرگمنت اجباری روی کانفیگ‌ها"
                              Style="{StaticResource GlobalCheckBoxStyle}"
                              Margin="0,8"
                              AutomationProperties.Name="فرگمنت اجباری" />
                    <StackPanel Orientation="Horizontal" Margin="24,0,0,8">
                        <TextBlock Text="طول فرگمنت:" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="16" />
                        <TextBox x:Name="FragmentLengthBox"
                                 Text="10-20"
                                 Width="100"
                                 Style="{StaticResource GlobalTextBoxStyle}"
                                 Margin="8,0,0,0" />
                        <TextBlock Text="فاصله:" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="16" Margin="16,0,0,0" />
                        <TextBox x:Name="FragmentIntervalBox"
                                 Text="10-20"
                                 Width="100"
                                 Style="{StaticResource GlobalTextBoxStyle}"
                                 Margin="8,0,0,0" />
                    </StackPanel>

                    <CheckBox x:Name="AutoConnectCheck"
                              Content="اتصال خودکار هنگام اجرای برنامه"
                              Style="{StaticResource GlobalCheckBoxStyle}"
                              Margin="0,8"
                              AutomationProperties.Name="اتصال خودکار" />
                    <CheckBox x:Name="AutoUpdateCheck"
                              Content="بروزرسانی خودکار لینک‌های اشتراک هنگام شروع"
                              Style="{StaticResource GlobalCheckBoxStyle}"
                              Margin="0,8"
                              IsChecked="True"
                              AutomationProperties.Name="بروزرسانی خودکار اشتراک" />
                </StackPanel>
            </GroupBox>

            <!-- Section 2: DNS Configuration -->
            <GroupBox Header="پیکربندی DNS" Style="{StaticResource GlobalGroupBoxStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="دی‌ان‌اس امن داخل تونل (DoH):" Width="250" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="16" />
                        <TextBox x:Name="RemoteDnsBox"
                                 Text="https://1.1.1.1/dns-query"
                                 Width="450"
                                 Style="{StaticResource GlobalTextBoxStyle}"
                                 AutomationProperties.Name="دی‌ان‌اس امن برای تونل" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="دی‌ان‌اس مستقیم ایران:" Width="250" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="16" />
                        <TextBox x:Name="DirectDnsBox"
                                 Text="1.1.1.1"
                                 Width="450"
                                 Style="{StaticResource GlobalTextBoxStyle}"
                                 AutomationProperties.Name="دی‌ان‌اس مستقیم برای سایت‌های ایران" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Section 3: Split Tunneling -->
            <GroupBox Header="اسپلیت تونلینگ (Split Tunneling)" Style="{StaticResource GlobalGroupBoxStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="SplitTunnelCheck"
                              Content="فعال‌سازی اسپلیت تونلینگ"
                              Style="{StaticResource GlobalCheckBoxStyle}"
                              Margin="0,8"
                              AutomationProperties.Name="فعال‌سازی اسپلیت تونلینگ" />

                    <StackPanel Orientation="Horizontal" Margin="24,0,0,8">
                        <TextBlock Text="حالت:" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="16" />
                        <ComboBox x:Name="SplitTunnelModeBox"
                                  Width="350"
                                  Margin="8,0,0,0"
                                  Style="{StaticResource GlobalComboBoxStyle}"
                                  SelectedIndex="0"
                                  AutomationProperties.Name="حالت اسپلیت تونلینگ">
                            <ComboBoxItem Content="برنامه‌های انتخاب شده بدون فیلترشکن و مستقیم کار کنند" Tag="ExcludeApps" />
                            <ComboBoxItem Content="فقط برنامه‌های انتخاب شده از فیلترشکن رد شوند" Tag="OnlySelectedApps" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="24,0,0,8">
                        <TextBlock Text="برنامه‌های در حال اجرا (برای اضافه کردن به لیست):" Foreground="#D4AF37" FontSize="16" Margin="0,0,0,4" />
                        <ListBox x:Name="ProcessListBox"
                                 Height="200"
                                 Background="#0A0A0A"
                                 Foreground="#FFFFFF"
                                 BorderBrush="#FFFFFF"
                                 BorderThickness="2"
                                 FontFamily="{StaticResource FontVazirmatn}"
                                 FontSize="16"
                                 SelectionMode="Multiple"
                                 AutomationProperties.Name="لیست برنامه‌های در حال اجرا">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Foreground="#FFFFFF"
                                              FontFamily="{StaticResource FontVazirmatn}"
                                              FontSize="16"
                                              VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="بروزرسانی لیست برنامه‌های در حال اجرا"
                                    Style="{StaticResource GlobalButtonStyle}"
                                    Width="300"
                                    Click="BtnRefreshProcesses_Click"
                                    AutomationProperties.Name="بروزرسانی لیست پردازش‌ها" />
                            <Button Content="اضافه کردن انتخاب‌ها به اسپلیت تونل"
                                    Style="{StaticResource GlobalButtonStyle}"
                                    Width="250"
                                    Margin="8,0,0,0"
                                    Click="BtnAddSelectedProcesses_Click"
                                    AutomationProperties.Name="اضافه کردن برنامه‌های انتخاب شده به لیست اسپلیت تونل" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="24,0,0,8">
                        <TextBlock Text="دامنه/IP سفارشی:" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="16" Width="180" />
                        <TextBox x:Name="CustomDomainIpBox"
                                 PlaceholderText="example.com یا 1.2.3.4/24"
                                 Width="350"
                                 Style="{StaticResource GlobalTextBoxStyle}"
                                 Margin="8,0,0,0"
                                 AutomationProperties.Name="دامنه یا آی‌پی سفارشی" />
                        <Button Content="افزودن"
                                Style="{StaticResource GlobalButtonStyle}"
                                Width="100"
                                Margin="8,0,0,0"
                                Click="BtnAddCustomDomainIp_Click"
                                AutomationProperties.Name="افزودن دامنه یا آی‌پی سفارشی" />
                    </StackPanel>

                    <ListBox x:Name="CustomDomainIpListBox"
                             Height="100"
                             Background="#0A0A0A"
                             Foreground="#FFFFFF"
                             BorderBrush="#FFFFFF"
                             BorderThickness="2"
                             FontFamily="{StaticResource FontVazirmatn}"
                             FontSize="16"
                             Margin="24,0,0,8"
                             AutomationProperties.Name="لیست دامنه‌ها و آی‌پی‌های سفارشی">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="16" Margin="8" />
                                    <Button Grid.Column="1" Content="حذف" Style="{StaticResource GlobalButtonStyle}" Width="80" Margin="0,0,8,0" Tag="{Binding}" Click="BtnRemoveCustomDomainIp_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </GroupBox>

            <!-- Section 4: Backup & Restore -->
            <GroupBox Header="پشتیبان‌گیری و بازیابی" Style="{StaticResource GlobalGroupBoxStyle}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Button Content="پشتیبان‌گیری از تمام تنظیمات"
                            Style="{StaticResource GlobalButtonStyle}"
                            Width="250"
                            Click="BtnExportSettings_Click"
                            AutomationProperties.Name="خروجی گرفتن از تنظیمات" />
                    <Button Content="بازیابی فایل پشتیبان"
                            Style="{StaticResource GlobalButtonStyle}"
                            Width="250"
                            Margin="8,0,0,0"
                            Click="BtnImportSettings_Click"
                            AutomationProperties.Name="وارد کردن تنظیمات از فایل پشتیبان" />
                </StackPanel>
            </GroupBox>

            <!-- Save & Close -->
            <Button x:Name="BtnSaveClose"
                    Content="ذخیره و بستن تنظیمات"
                    HorizontalAlignment="Right"
                    Style="{StaticResource GlobalButtonStyle}"
                    Tag="Active"
                    Width="220"
                    Height="56"
                    FontSize="20"
                    Click="BtnSaveClose_Click"
                    AutomationProperties.Name="ذخیره تنظیمات و بستن پنجره" />
        </StackPanel>
    </ScrollViewer>
</Window>